grace_timer     = 20 * 60; // 20s initial peaceful work grace period
home_desk_x     = x;
home_desk_y     = y;
assigned_term   = noone;
target_x        = x;
target_y        = y;
target_room     = ROOM_INTERN_WORK;
waypoints       = [];
current_wp      = 0;
mischief_target = noone;
mischief_timer  = 0;
vent_target     = noone;
door_cooldown   = 0;
vent_cooldown   = 0;
move_speed      = 1.1; // Manageable toddler waddle speed (Jack walks at 2.5, sprints at 4.2)
walk_timer      = 0;
knockout_timer  = 1800; // 30 seconds to rescue before suffocation fatality
revive_meter    = 0;
is_cpr_target   = false;
soothe_timer    = 0;
tie_color       = choose(c_red, c_blue, make_color_rgb(255, 120, 40), make_color_rgb(140, 60, 200));
hair_color      = choose(make_color_rgb(50, 35, 20), make_color_rgb(210, 160, 50), make_color_rgb(150, 40, 20), make_color_rgb(30, 30, 30));
face_dir        = 270;
near_player     = false;
depth           = 22;
mask_index      = -1;
intern_variant  = 1;
sprite_index    = intern1;
