/// @description obj_doorway — Create Event
/// Renders a sleek Corporate Automatic Sliding Door on standard room doorways (TILE_DOOR).
/// Slides open automatically when Jack approaches so every room entrance looks like a real door!

depth            = 26; // Draws above floor (50) and below room fog (10)
has_lock_overlay = false;
open_amt         = 0.0;
anim_t           = irandom(100);
